# UNREAL Dashboard — environment variables
# Copy this file to .env (or .env.local) and adjust as needed.
# Do NOT commit .env / .env.local (already in .gitignore).

# ─── Database ──────────────────────────────────────────────────────────
# Local SQLite by default. The prisma/dev.db file is gitignored.
# Run:  npx prisma migrate dev  to initialise the schema locally.
DATABASE_URL="file:./prisma/dev.db"

# For production, point at any Prisma-supported database, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
